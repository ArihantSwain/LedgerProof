# Example only. See docs/integration-status.md for actual verification evidence.
APP_ORIGIN=http://localhost:3000
# Set server-side after creating your Convex deployment:
CONVEX_URL=
# Generate a random server-only secret, then set the same in Convex dashboard.
LEDGERPROOF_BACKEND_SECRET=
# Select exactly one account-supported API family, never an automatic fallback.
CREAO_API_FAMILY=agent-v1
# developer-v2: https://developer.creao.ai/v2
# agent-v1: https://agent.creao.ai/api/v1
CREAO_API_BASE=https://agent.creao.ai/api/v1
CREAO_API_KEY=
CREAO_AGENT_ID=
# Set only after confirming the selected API family and account contract:
CREAO_CONTRACT_VERIFIED=false
# agent-v1 only: actual input form field, created as "bundle" in agent setup.
CREAO_INPUT_FIELD=bundle
# Exact result field contract needs a successful account smoke test.

# Claude direct accounting reviews: fixed Haiku 4.5, $5 lifetime app cap / 50 reservations.
# No automatic retries or background reviews; the remaining credit balance is external.
ANTHROPIC_API_KEY=
# Only if your API key needs an explicit workspace ID:
ANTHROPIC_WORKSPACE_ID=

# CRS CalHacks sandbox credentials. Quote passwords containing #.
CRS_USERNAME=
CRS_PASSWORD=""

# Coinbase CDP keys: https://portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# Real external Exa evidence purchases: owner approval + funded Base-mainnet wallet.
# Max 0.01 USDC each; max 0.10 USDC / 10 reservations across this deployment.
LEDGERPROOF_X402_EVIDENCE_ENABLED=false
# Optional receiving address for the separate Base-Sepolia protocol harness:
X402_PAY_TO=

# Dedicated offline tests disable every paid provider and use local persistence.
LEDGERPROOF_OFFLINE_REHEARSAL=false
