{
  "name": "ledgerproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "fixtures": "tsx scripts/fixtures.ts",
    "test:e2e": "playwright test",
    "smoke:creao": "tsx scripts/smoke-creao.ts",
    "doctor": "node --import tsx scripts/doctor.ts",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "docs:build": "python3 scripts/render-diagrams.py && node --import tsx scripts/build-briefing.ts",
    "docs:export": "node --import tsx scripts/export-docs.ts",
    "fixtures:creao": "node --import tsx scripts/prepare-creao.ts"
  },
  "dependencies": {
    "convex": "^1.31.0",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "unpdf": "^1.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "marked": "^18.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
