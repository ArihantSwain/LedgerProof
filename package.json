{
  "name": "ledgerproof",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "fixtures": "tsx scripts/fixtures.ts",
    "test:e2e": "playwright test",
    "smoke:creao": "tsx scripts/smoke-creao.ts",
    "doctor": "node --import tsx scripts/doctor.ts",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "docs:build": "python3 scripts/render-diagrams.py && node --import tsx scripts/build-briefing.ts",
    "docs:export": "node --import tsx scripts/export-docs.ts",
    "fixtures:creao": "node --import tsx scripts/prepare-creao.ts",
    "setup:convex": "node --import tsx scripts/setup-convex.ts",
    "verify:claude": "node --import tsx scripts/verify-claude.ts",
    "verify:creao": "node --import tsx scripts/verify-creao.ts",
    "verify:convex": "node --import tsx scripts/verify-convex.ts",
    "test:convex": "vitest run --config vitest.convex.config.ts",
    "verify:x402": "node --import tsx scripts/verify-x402-evidence.ts",
    "verify:crs": "node --import tsx scripts/verify-crs.ts",
    "verify:hosted": "node --import tsx scripts/verify-hosted.ts",
    "examples:build": "tsx scripts/judge-examples.ts",
    "examples:verify": "tsx --test tests/judge-examples.test.ts",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "@coinbase/cdp-cli": "^2.0.124",
    "@coinbase/cdp-sdk": "^1.60.0",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "@x402/next": "^2.28.0",
    "@x402/svm": "^2.28.0",
    "convex": "^1.31.0",
    "fflate": "^0.8.2",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "unpdf": "^1.3.0",
    "viem": "^2.57.11",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@crscreditapi/crs-calhacks-mcp-server": "^1.1.2",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "convex-test": "^0.0.65",
    "marked": "^18.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
