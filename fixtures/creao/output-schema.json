{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "inputVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "findings": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "type": {
            "type": "string",
            "enum": [
              "duplicate_invoice",
              "unapplied_credit_note",
              "unmatched_receipt",
              "partial_payment",
              "inconsistent_amount",
              "collection_risk_evidence",
              "insufficient_evidence"
            ]
          },
          "affectedRecordIds": {
            "minItems": 1,
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "evidenceRefs": {
            "minItems": 1,
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "certaintyLabel": {
            "type": "string",
            "enum": [
              "supported",
              "possible",
              "insufficient"
            ]
          },
          "proposedAction": {
            "type": "string",
            "enum": [
              "review_duplicate",
              "review_credit_application",
              "review_receipt_match",
              "review_collection_scenario",
              "request_evidence"
            ]
          },
          "needsHumanReview": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "type",
          "affectedRecordIds",
          "evidenceRefs",
          "explanation",
          "certaintyLabel",
          "proposedAction",
          "needsHumanReview"
        ],
        "additionalProperties": false
      }
    },
    "missingEvidence": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 5000
    }
  },
  "required": [
    "schemaVersion",
    "inputVersion",
    "findings",
    "missingEvidence",
    "summary"
  ],
  "additionalProperties": false
}
